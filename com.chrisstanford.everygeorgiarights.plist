<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.chrisstanford.everygeorgiarights</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/christopherstanford/Scripts/everygeorgia/rights_join_tick.sh</string>
    </array>

    <!-- Every 15 minutes. launchd re-fires a StartInterval job after the machine
         wakes, which is the whole reason this is a timer rather than a resident
         watcher. The script exits immediately once data/georgia_rights.csv
         exists, so the job costs nothing once the join has succeeded. -->
    <key>StartInterval</key>
    <integer>900</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>WorkingDirectory</key>
    <string>/Users/christopherstanford/Scripts/everygeorgia</string>

    <!-- launchd's PATH is /usr/bin:/bin:/usr/sbin:/sbin with no Homebrew and no
         python.org. rights_join.py is stdlib-only so Apple's python3 would do,
         but pin the framework build to match the rest of the estate. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Library/Frameworks/Python.framework/Versions/3.13/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/christopherstanford/Library/Logs/everygeorgia-rights.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/christopherstanford/Library/Logs/everygeorgia-rights.log</string>
</dict>
</plist>
